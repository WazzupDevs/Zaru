// Event Fleet Platform — initial Prisma schema.
// Conventions: see docs/adr/0003-data-conventions.md.
// All tables: snake_case names, created_at / updated_at / deleted_at on every row.
// Critical aggregates (Booking, Payment, Wallet — coming in A2/Phase 3) add `version`.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pgcrypto]
}

enum UserRole {
  CUSTOMER
  DRIVER
  ADMIN
  SUPPORT
}

enum OtpChannel {
  SMS
}

enum OtpPurpose {
  LOGIN
}

model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneE164          String    @map("phone_e164")
  displayName        String?   @map("display_name")
  role               UserRole  @default(CUSTOMER)
  tenantId           String?   @map("tenant_id") @db.Uuid
  phoneVerifiedAt    DateTime? @map("phone_verified_at")
  lastLoginAt        DateTime? @map("last_login_at")
  // A4e-3 — push token, set after the mobile app obtains it from
  // expo-notifications.getExpoPushTokenAsync(). Nullable: the user may
  // have denied permission, be on a simulator, or have logged in from
  // a build that pre-dates push registration. Listener treats null as
  // "fall back to SMS". `pushTokenUpdatedAt` lets the worker prune
  // stale tokens (Expo invalidates after ~6 months of inactivity).
  expoPushToken      String?   @map("expo_push_token")
  pushTokenUpdatedAt DateTime? @map("push_token_updated_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  refreshTokens     RefreshToken[]
  driverProfile     DriverProfile?
  bookings          Booking[]      @relation("BookingCustomer")
  cancelledBookings Booking[]      @relation("BookingCancelledBy")
  acceptedInvite    DriverInvite?  @relation("AcceptedDriverInvite")
  invitedDrivers    DriverInvite[] @relation("InvitedByAdmin")

  @@index([phoneE164])
  @@map("users")
}

// =====================================================================
// Driver invitations (A4f-1) — closed-beta whitelist gating.
// Admin invites a TR mobile by phone; the driver app's auth flow only
// proceeds for phones with a PENDING invite. On successful OTP verify
// the invite goes ACCEPTED, the User row's role flips to DRIVER, and
// a DriverProfile auto-provisions in APPROVED status.
//
// Phone is stored both clear (for admin display) and hashed (for the
// listener's lookup; ADR 0016 hash discipline). The hash makes the
// whitelist check resistant to a leaked DB dump revealing the invite
// list as a phone-number harvest.
// =====================================================================

enum DriverInviteStatus {
  PENDING // Invited, driver hasn't logged in yet.
  ACCEPTED // Driver completed OTP verify; User + DriverProfile provisioned.
  REVOKED // Admin pulled the invite. Driver can no longer log in via this row.
}

model DriverInvite {
  id            String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  phoneE164     String @map("phone_e164")
  phoneE164Hash String @map("phone_e164_hash")

  status         DriverInviteStatus @default(PENDING)
  invitedAt      DateTime           @default(now()) @map("invited_at")
  acceptedAt     DateTime?          @map("accepted_at")
  acceptedUserId String?            @unique @map("accepted_user_id") @db.Uuid

  invitedByAdminId String  @map("invited_by_admin_id") @db.Uuid
  notes            String?

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  acceptedUser   User? @relation("AcceptedDriverInvite", fields: [acceptedUserId], references: [id])
  invitedByAdmin User  @relation("InvitedByAdmin", fields: [invitedByAdminId], references: [id])

  // Whitelist lookup hot path — hash + status filter.
  @@index([phoneE164Hash, status])
  // Admin list sort.
  @@index([status, invitedAt])
  @@map("driver_invites")
}

model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  // Rotation chain root. All tokens issued through rotation share the same
  // family_id. Reuse of a revoked token in the family triggers a cascading
  // revoke of the entire family — see ADR 0008.
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model OtpRequest {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  phoneE164    String     @map("phone_e164")
  codeHash     String     @map("code_hash") // argon2id hash; plaintext NEVER stored
  channel      OtpChannel @default(SMS)
  purpose      OtpPurpose @default(LOGIN)
  expiresAt    DateTime   @map("expires_at")
  consumedAt   DateTime?  @map("consumed_at") // single-use sentinel
  attemptCount Int        @default(0) @map("attempt_count")
  ipAddress    String?    @map("ip_address")
  userAgent    String?    @map("user_agent")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  @@index([phoneE164, createdAt])
  @@index([expiresAt])
  @@map("otp_requests")
}

model IdempotencyRecord {
  key          String   @id // value of Idempotency-Key header
  requestHash  String   @map("request_hash") // sha256(method + path + canonical body)
  responseCode Int      @map("response_code")
  responseBody Json     @map("response_body")
  userId       String?  @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at") // TTL cleanup driven by worker (A2c+)

  @@index([expiresAt])
  @@map("idempotency_records")
}

model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")
  retryCount    Int       @default(0) @map("retry_count")
  lastError     String?   @map("last_error")
  // Worker uses this for exponential-backoff retries:
  // WHERE processed_at IS NULL AND (next_attempt_at IS NULL OR next_attempt_at <= now())
  // NULL = ready immediately (initial state).
  nextAttemptAt DateTime? @map("next_attempt_at")

  @@index([processedAt, createdAt])
  @@index([processedAt, nextAttemptAt, createdAt])
  @@map("outbox_events")
}

// =====================================================================
// Notifications (A4e-1) — outbox events → SMS (and later push/email).
// PII discipline: recipient_phone + rendered_body are plaintext (provider
// needs them clear) but log redaction masks both. ADR 0021.
// =====================================================================

enum NotificationChannel {
  SMS
  PUSH // wired in A4e-2
  EMAIL // Phase 3+
}

enum NotificationStatus {
  PENDING // outbox listener queued the row, BullMQ holds the job
  SENDING // worker picked it up
  SENT // provider acknowledged (HTTP 200 / "00 ok" from Netgsm)
  DELIVERED // provider delivery callback (Phase 3+)
  FAILED // last send attempt errored — retryable until DEAD_LETTERED (A4e-2)
  DEAD_LETTERED // retry budget exhausted (A4e-2)
}

enum NotificationKind {
  // Customer-facing
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_EXPIRED
  DRIVER_ASSIGNED_TO_BOOKING
  // Driver-facing
  NEW_BOOKING_OFFER
  BOOKING_CANCELLED_DRIVER
  // Identity
  OTP_REQUEST
}

model Notification {
  id                 String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  channel            NotificationChannel
  kind               NotificationKind
  recipientUserId    String?             @map("recipient_user_id") @db.Uuid
  // Plaintext on purpose — provider call needs the raw phone. Log
  // redaction masks `*.recipientPhone`. Stored for audit + replay.
  recipientPhone     String              @map("recipient_phone")
  // A4e-3 — populated for PUSH channel rows so the sender can call
  // expo-server-sdk without a second DB hit. Mirrors recipientPhone for
  // SMS rows: stored on the notification (not joined from User) so a
  // post-hoc token rotation on the User row doesn't change replay shape.
  recipientPushToken String?             @map("recipient_push_token")

  templateKey  String @map("template_key") // "booking.confirmed"
  locale       String @default("tr")
  // Rendered body — plaintext, log-redacted (`*.renderedBody`). Kept on
  // the row so support can replay or inspect what the user actually saw.
  renderedBody String @map("rendered_body")

  status            NotificationStatus @default(PENDING)
  providerMessageId String?            @map("provider_message_id")
  providerError     String?            @map("provider_error")
  retryCount        Int                @default(0) @map("retry_count")
  // A4e-2: per-attempt journal so the admin can see why a row dead-lettered
  // without trawling logs. Shape: [{ attempt: 1, error: "...", attemptedAt: "ISO" }].
  attemptHistory    Json               @default("[]") @map("attempt_history")

  sourceEventType   String? @map("source_event_type")
  sourceAggregateId String? @map("source_aggregate_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  sentAt      DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  failedAt    DateTime? @map("failed_at")

  deadLetter NotificationDeadLetter?

  @@index([recipientUserId, createdAt])
  @@index([status, createdAt])
  @@index([sourceAggregateId])
  // Idempotency lookup for QueueNotificationUseCase — find duplicates
  // within a 24h window keyed by (sourceAggregateId, kind, recipientPhone).
  @@index([sourceAggregateId, kind, recipientPhone, createdAt])
  @@map("notifications")
}

// Dead Letter Queue — terminal failure records (A4e-2). The notification
// row itself transitions to DEAD_LETTERED, but its mutable fields are
// snapshotted here so investigators see the body + error history that
// triggered the dead-lettering even if the source row is later edited.
// ADR 0022 — retry strategy.
model NotificationDeadLetter {
  id             String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  notificationId String @unique @map("notification_id") @db.Uuid

  // Snapshot at dead-letter time.
  channel        NotificationChannel
  kind           NotificationKind
  recipientPhone String              @map("recipient_phone")
  renderedBody   String              @map("rendered_body")

  finalError     String   @map("final_error")
  attempts       Int
  firstAttemptAt DateTime @map("first_attempt_at")
  lastAttemptAt  DateTime @map("last_attempt_at")
  deadLetteredAt DateTime @default(now()) @map("dead_lettered_at")

  // Per-attempt history snapshot (mirrors notification.attemptHistory at
  // the moment of dead-lettering).
  attemptHistory Json @map("attempt_history")

  // Investigation audit (admin endpoint sets these).
  investigatedAt       DateTime? @map("investigated_at")
  investigatedByUserId String?   @map("investigated_by_user_id") @db.Uuid
  resolution           String?

  notification Notification @relation(fields: [notificationId], references: [id])

  @@index([deadLetteredAt])
  @@index([investigatedAt])
  @@map("notification_dead_letters")
}

// =====================================================================
// Catalog (A3a) — polymorphic vertical model. New verticals (oto kurtarıcı,
// vale, kurumsal servis) are added by inserting category + attribute defs,
// not by writing code. See ADR 0012.
// =====================================================================

enum ServiceCategoryType {
  PLANNED_EVENT // wedding, engagement — date-reserved
  ON_DEMAND_DISPATCH // tow, valet — instant
  SCHEDULED_TRANSPORT // shuttle, corporate — recurring
}

model ServiceCategory {
  id            String                        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug          String                        @unique // "wedding-car"
  name          String // "Düğün Arabası"
  description   String?
  type          ServiceCategoryType
  iconUrl       String?                       @map("icon_url")
  isActive      Boolean                       @default(true) @map("is_active")
  sortOrder     Int                           @default(0) @map("sort_order")
  createdAt     DateTime                      @default(now()) @map("created_at")
  updatedAt     DateTime                      @updatedAt @map("updated_at")
  deletedAt     DateTime?                     @map("deleted_at")
  vehicleTypes  VehicleType[]
  attributeDefs CategoryAttributeDefinition[]
  pricingRules  PricingRule[]
  priceQuotes   PriceQuote[]
  bookings      Booking[]

  @@index([isActive, sortOrder])
  @@map("service_categories")
}

model VehicleType {
  id             String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  categoryId     String          @map("category_id") @db.Uuid
  slug           String // "classic-sedan"
  name           String // "Klasik Sedan"
  description    String?
  capacityMin    Int             @default(1) @map("capacity_min")
  capacityMax    Int             @map("capacity_max")
  isActive       Boolean         @default(true) @map("is_active")
  sortOrder      Int             @default(0) @map("sort_order")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")
  category       ServiceCategory @relation(fields: [categoryId], references: [id])
  vehicles       Vehicle[]
  pricingProfile PricingProfile?
  pricingRules   PricingRule[]
  priceQuotes    PriceQuote[]
  bookings       Booking[]

  @@unique([categoryId, slug])
  @@index([categoryId, isActive, sortOrder])
  @@map("vehicle_types")
}

enum AttributeDataType {
  STRING
  NUMBER
  BOOLEAN
  ENUM
  DATE
}

enum AttributeScope {
  VEHICLE // tied to the vehicle (color, has-AC)
  BOOKING // tied to the rental (hours of use, ceremony location)
}

model CategoryAttributeDefinition {
  id              String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  categoryId      String            @map("category_id") @db.Uuid
  key             String // "trim_color"
  label           String // "Süsleme Rengi"
  dataType        AttributeDataType @map("data_type")
  scope           AttributeScope
  isRequired      Boolean           @default(false) @map("is_required")
  enumOptions     Json?             @map("enum_options") // ["white", "red"]
  validationRules Json?             @map("validation_rules") // {min: 0, max: 100}
  sortOrder       Int               @default(0) @map("sort_order")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")
  category        ServiceCategory   @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, key, scope])
  @@index([categoryId, scope, sortOrder])
  @@map("category_attribute_definitions")
}

// =====================================================================
// Supply (A3b) — driver onboarding aggregate root + vehicles + documents.
// PII (national_id, IBAN) lives only as hashes; plaintext never persisted.
// See ADR 0016 for the hashing strategy.
// =====================================================================

enum DriverOnboardingStatus {
  DRAFT
  DOCUMENTS_PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model DriverProfile {
  id               String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // user_id is unique (a user has at most one driver profile, alive or
  // soft-deleted). We enforce that via @unique here AND a partial unique
  // index on the active row (added in migration SQL).
  userId           String                 @unique @map("user_id") @db.Uuid
  firstName        String                 @map("first_name")
  lastName         String                 @map("last_name")
  // HMAC-SHA256 hex; used for admin lookup. ADR 0016.
  nationalIdHash   String                 @map("national_id_hash")
  birthDate        DateTime               @map("birth_date") @db.Date
  // argon2id; non-deterministic. Display uses ibanLast4.
  ibanHash         String                 @map("iban_hash")
  ibanLast4        String                 @map("iban_last4")
  status           DriverOnboardingStatus @default(DRAFT)
  rejectionReason  String?                @map("rejection_reason")
  approvedAt       DateTime?              @map("approved_at")
  approvedByUserId String?                @map("approved_by_user_id") @db.Uuid
  // Marketplace commission as a fraction (0.15 = 15%). Override per driver
  // is allowed; default mirrors iyzico onboarding contract.
  commissionRate   Decimal                @default(0.15) @map("commission_rate") @db.Decimal(5, 4)

  // Dispatch metadata (A4c). Driver app (A4f) reports location every few
  // minutes; admin console can also write for tests. The generated
  // last_known_location geography column + GIST index live in raw SQL —
  // Prisma DSL has no PostGIS support.
  lastKnownLat       Decimal?  @map("last_known_lat") @db.Decimal(10, 7)
  lastKnownLng       Decimal?  @map("last_known_lng") @db.Decimal(10, 7)
  lastLocationUpdate DateTime? @map("last_location_update")
  isOnline           Boolean   @default(false) @map("is_online")
  // Aggregate rating — Reviews module (Faz 3) populates; default 5.0 so
  // brand-new approved drivers aren't filtered out by minRating.
  ratingAverage      Decimal   @default(5.0) @map("rating_average") @db.Decimal(3, 2)
  ratingCount        Int       @default(0) @map("rating_count")

  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  deletedAt      DateTime?             @map("deleted_at")
  version        Int                   @default(0)
  user           User                  @relation(fields: [userId], references: [id])
  vehicles       Vehicle[]
  documents      Document[]
  availabilities VehicleAvailability[]
  bookings       Booking[]

  @@index([status])
  @@index([isOnline, lastLocationUpdate])
  @@index([nationalIdHash])
  @@map("driver_profiles")
}

enum VehicleStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

model Vehicle {
  id              String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  driverProfileId String                @map("driver_profile_id") @db.Uuid
  vehicleTypeId   String                @map("vehicle_type_id") @db.Uuid
  // Stored normalized (PlateVO output): uppercase, no spaces.
  plateNumber     String                @map("plate_number")
  brand           String
  model           String
  year            Int
  color           String
  // Polymorphic per-category attributes (catalog scope=VEHICLE definitions).
  attributes      Json                  @default("{}")
  photoKeys       String[]              @map("photo_keys")
  status          VehicleStatus         @default(DRAFT)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  deletedAt       DateTime?             @map("deleted_at")
  version         Int                   @default(0)
  driverProfile   DriverProfile         @relation(fields: [driverProfileId], references: [id])
  vehicleType     VehicleType           @relation(fields: [vehicleTypeId], references: [id])
  availabilities  VehicleAvailability[]
  bookings        Booking[]

  @@index([driverProfileId])
  @@index([status])
  @@map("vehicles")
}

enum DocumentType {
  DRIVER_LICENSE
  VEHICLE_REGISTRATION
  INSURANCE
  KASKO
  AUTHORITY_CERTIFICATE
  IDENTITY_CARD
}

enum DocumentStatus {
  UPLOADED
  APPROVED
  REJECTED
  EXPIRED
}

model Document {
  id               String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  driverProfileId  String         @map("driver_profile_id") @db.Uuid
  vehicleId        String?        @map("vehicle_id") @db.Uuid
  type             DocumentType
  storageKey       String         @map("storage_key")
  fileName         String         @map("file_name")
  fileSize         Int            @map("file_size")
  mimeType         String         @map("mime_type")
  issuedAt         DateTime?      @map("issued_at") @db.Date
  expiresAt        DateTime?      @map("expires_at") @db.Date
  status           DocumentStatus @default(UPLOADED)
  reviewedByUserId String?        @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?      @map("reviewed_at")
  rejectionReason  String?        @map("rejection_reason")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")
  driverProfile    DriverProfile  @relation(fields: [driverProfileId], references: [id])

  @@index([driverProfileId])
  @@index([vehicleId])
  @@index([expiresAt])
  @@map("documents")
}

enum AvailabilityType {
  BLOCKED // driver-initiated calendar block
  BOOKED // booking-initiated reservation (A4 booking will populate)
}

model VehicleAvailability {
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  vehicleId       String           @map("vehicle_id") @db.Uuid
  driverProfileId String           @map("driver_profile_id") @db.Uuid
  startAt         DateTime         @map("start_at")
  endAt           DateTime         @map("end_at")
  type            AvailabilityType @default(BLOCKED)
  // Booking aggregate id — A4 booking module fills this when an actual
  // booking blocks the calendar. NULL for driver-side BLOCKED rows.
  bookingId       String?          @map("booking_id") @db.Uuid
  reason          String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  vehicle         Vehicle          @relation(fields: [vehicleId], references: [id])
  driverProfile   DriverProfile    @relation(fields: [driverProfileId], references: [id])

  @@index([vehicleId, startAt, endAt])
  @@index([startAt, endAt])
  @@map("vehicle_availabilities")
}

// =====================================================================
// Pricing (A4a) — deterministic dynamic pricing. Admin owns rules; quote
// captures a snapshot so later rule edits do NOT mutate live quotes.
// All money columns are Decimal — never JS number. ADR 0017.
// =====================================================================

model PricingProfile {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  vehicleTypeId String      @unique @map("vehicle_type_id") @db.Uuid
  currency      String      @default("TRY")
  baseFee       Decimal     @map("base_fee") @db.Decimal(10, 2)
  perKmFee      Decimal     @map("per_km_fee") @db.Decimal(10, 2)
  perHourFee    Decimal     @map("per_hour_fee") @db.Decimal(10, 2)
  minimumHours  Int         @default(2) @map("minimum_hours")
  // Distance included in baseFee — only kilometers above this count are billed.
  includedKm    Int         @default(0) @map("included_km")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  version       Int         @default(0)
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])

  @@map("pricing_profiles")
}

enum PricingRuleType {
  SEASONAL_MULTIPLIER // multiplier active inside [validFrom, validTo]
  DAY_OF_WEEK_MULTIPLIER // multiplier active when daysOfWeek bitmask matches
  ADDON // fixed amount the customer can opt into
}

model PricingRule {
  id            String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type          PricingRuleType
  // Optional scoping. NULL = applies to every category / vehicle type.
  categoryId    String?          @map("category_id") @db.Uuid
  vehicleTypeId String?          @map("vehicle_type_id") @db.Uuid
  name          String
  description   String?
  // Seasonal range (inclusive). Null = no seasonal bound.
  validFrom     DateTime?        @map("valid_from") @db.Date
  validTo       DateTime?        @map("valid_to") @db.Date
  // Bit-OR mask. Bit 0 = Monday … bit 6 = Sunday. Used by DAY_OF_WEEK type.
  daysOfWeek    Int?             @map("days_of_week")
  // SEASONAL_MULTIPLIER + DAY_OF_WEEK_MULTIPLIER use this.
  multiplier    Decimal?         @db.Decimal(4, 2)
  // ADDON uses this.
  fixedAmount   Decimal?         @map("fixed_amount") @db.Decimal(10, 2)
  // ADDON-only flag: true means the customer chooses, false means always applied.
  isOptional    Boolean          @default(false) @map("is_optional")
  sortOrder     Int              @default(0) @map("sort_order")
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  version       Int              @default(0)
  category      ServiceCategory? @relation(fields: [categoryId], references: [id])
  vehicleType   VehicleType?     @relation(fields: [vehicleTypeId], references: [id])

  @@index([type, isActive])
  @@index([validFrom, validTo])
  @@map("pricing_rules")
}

enum PriceQuoteStatus {
  ACTIVE // freshly calculated, within TTL
  EXPIRED // past TTL — re-request needed
  CONSUMED // a Booking aggregate now references this quote
}

model PriceQuote {
  id                  String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requestedByUserId   String           @map("requested_by_user_id") @db.Uuid
  vehicleTypeId       String           @map("vehicle_type_id") @db.Uuid
  categoryId          String           @map("category_id") @db.Uuid
  // Pickup / dropoff
  pickupLat           Decimal          @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng           Decimal          @map("pickup_lng") @db.Decimal(10, 7)
  pickupAddress       String           @map("pickup_address")
  dropoffLat          Decimal          @map("dropoff_lat") @db.Decimal(10, 7)
  dropoffLng          Decimal          @map("dropoff_lng") @db.Decimal(10, 7)
  dropoffAddress      String           @map("dropoff_address")
  // Computed by DistanceCalculatorPort (Google Maps / Mock).
  distanceKm          Decimal          @map("distance_km") @db.Decimal(8, 2)
  durationMinutes     Int              @map("duration_minutes")
  // Event window
  eventStartAt        DateTime         @map("event_start_at")
  eventEndAt          DateTime         @map("event_end_at")
  durationHours       Decimal          @map("duration_hours") @db.Decimal(5, 2)
  // Calculation snapshot. Frozen at create time so later rule edits don't
  // mutate live quotes. Shape is documented in price-breakdown.vo.ts.
  breakdown           Json
  totalAmount         Decimal          @map("total_amount") @db.Decimal(10, 2)
  currency            String           @default("TRY")
  // Optional addon rule ids the customer opted into.
  selectedAddons      String[]         @default([]) @map("selected_addons") @db.Uuid
  status              PriceQuoteStatus @default(ACTIVE)
  expiresAt           DateTime         @map("expires_at")
  consumedAt          DateTime?        @map("consumed_at")
  consumedByBookingId String?          @map("consumed_by_booking_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at")
  vehicleType         VehicleType      @relation(fields: [vehicleTypeId], references: [id])
  category            ServiceCategory  @relation(fields: [categoryId], references: [id])
  booking             Booking?

  @@index([requestedByUserId, status])
  @@index([expiresAt])
  @@map("price_quotes")
}

// =====================================================================
// Booking (A4b) — full lifecycle aggregate. State transitions are guarded
// by BookingStateMachine in the domain layer; the DB enum is the storage
// contract, the state machine is the rulebook. See ADR 0019.
//
// Snapshot pattern: when ConfirmBooking consumes the quote, all pricing /
// pickup / dropoff fields are copied here. Later edits to the quote (or
// to PricingRule rows) do NOT mutate live bookings — immutable price
// guarantee from ADR 0017.
// =====================================================================

enum BookingStatus {
  DRAFT // quote consumed, awaiting payment confirmation (A4c) — bypassed in A4b
  CONFIRMED // customer confirmed; awaiting dispatch
  DRIVER_ASSIGNED // dispatch assigned a driver (A4d)
  IN_PROGRESS // event window started
  COMPLETED // driver marked done
  CANCELLED_BY_CUSTOMER // customer (or admin acting on behalf) cancelled
  CANCELLED_BY_DRIVER // driver declined or cancelled
  EXPIRED // DRAFT TTL elapsed without confirmation
  DISPUTED // (Phase 3+) escalated to manual review
}

model Booking {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  customerId   String        @map("customer_id") @db.Uuid
  priceQuoteId String        @unique @map("price_quote_id") @db.Uuid
  status       BookingStatus @default(DRAFT)

  // Quote snapshot — frozen at confirm time (immutable price guarantee).
  vehicleTypeId  String   @map("vehicle_type_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  pickupLat      Decimal  @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng      Decimal  @map("pickup_lng") @db.Decimal(10, 7)
  pickupAddress  String   @map("pickup_address")
  dropoffLat     Decimal  @map("dropoff_lat") @db.Decimal(10, 7)
  dropoffLng     Decimal  @map("dropoff_lng") @db.Decimal(10, 7)
  dropoffAddress String   @map("dropoff_address")
  eventStartAt   DateTime @map("event_start_at")
  eventEndAt     DateTime @map("event_end_at")
  totalAmount    Decimal  @map("total_amount") @db.Decimal(10, 2)
  currency       String   @default("TRY")

  // Lifecycle audit timestamps. Populated as the state machine advances.
  confirmedAt      DateTime? @map("confirmed_at")
  driverAssignedAt DateTime? @map("driver_assigned_at")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  cancelledAt      DateTime? @map("cancelled_at")
  expiredAt        DateTime? @map("expired_at")

  // Cancellation context.
  cancellationReason String? @map("cancellation_reason")
  cancelledByUserId  String? @map("cancelled_by_user_id") @db.Uuid

  // Driver / vehicle assignment (A4c dispatch).
  driverId  String? @map("driver_id") @db.Uuid
  vehicleId String? @map("vehicle_id") @db.Uuid

  // Dispatch metadata. Worker increments dispatchAttempts on each match
  // attempt; lastDispatchAt is the cooldown anchor (worker skips a row
  // dispatched in the last 60s). dispatchFailedReason is the most recent
  // failure code (no_drivers_in_radius / no_eligible_drivers / etc).
  dispatchAttempts     Int       @default(0) @map("dispatch_attempts")
  lastDispatchAt       DateTime? @map("last_dispatch_at")
  dispatchFailedReason String?   @map("dispatch_failed_reason")

  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  customer        User            @relation("BookingCustomer", fields: [customerId], references: [id])
  cancelledByUser User?           @relation("BookingCancelledBy", fields: [cancelledByUserId], references: [id])
  driver          DriverProfile?  @relation(fields: [driverId], references: [id])
  vehicle         Vehicle?        @relation(fields: [vehicleId], references: [id])
  priceQuote      PriceQuote      @relation(fields: [priceQuoteId], references: [id])
  vehicleType     VehicleType     @relation(fields: [vehicleTypeId], references: [id])
  category        ServiceCategory @relation(fields: [categoryId], references: [id])

  @@index([customerId, status])
  @@index([status, eventStartAt])
  @@index([driverId, status])
  @@index([eventStartAt])
  @@map("bookings")
}
