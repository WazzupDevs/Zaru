{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React / React Native / Next.js",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": false,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "verbatimModuleSyntax": false
  }
}
