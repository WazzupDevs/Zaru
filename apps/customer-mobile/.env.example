# API endpoint the mobile app talks to. EXPO_PUBLIC_* is the only env
# prefix Expo Metro inlines into the JS bundle at build time.
EXPO_PUBLIC_API_URL=http://localhost:3000

# A4g placeholder — replaced by `eas init` output when EAS Build is wired.
EXPO_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
