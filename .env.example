# Copy this file to `.env` for local development.
# Never commit `.env` — it is in .gitignore.

NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# --- Postgres (local dev via docker compose) ---
POSTGRES_USER=eventfleet
POSTGRES_PASSWORD=eventfleet
POSTGRES_DB=eventfleet
DATABASE_URL=postgresql://eventfleet:eventfleet@localhost:5432/eventfleet?schema=public

# --- Redis (local dev via docker compose) ---
REDIS_URL=redis://localhost:6379

# --- Authentication (A2c) ---
# Generate real values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Both secrets MUST be at least 64 hex chars (32 bytes). Rotate via .env, redeploy.
JWT_ACCESS_SECRET=changeme-use-openssl-rand-hex-32-or-node-crypto-randomBytes-32
JWT_REFRESH_SECRET=changeme-use-openssl-rand-hex-32-or-node-crypto-randomBytes-32
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
OTP_CODE_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5

# --- SMS driver: "mock" or "netgsm" (netgsm is skeleton-only until A3) ---
SMS_DRIVER=mock

# --- PII hashing (A3b) ---
# HMAC secret for deterministic TCKN hashing (admin lookup needs determinism).
# Generate a real value with `openssl rand -hex 32` or
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
PII_HMAC_SECRET=changeme-use-openssl-rand-hex-32-or-node-crypto-randomBytes-32

# --- Object storage (A3b: dev = MinIO via docker compose, prod = R2) ---
# Same env keys for both providers; only the endpoint + creds change.
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=eventfleet-dev-uploads
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL=http://localhost:9000/eventfleet-dev-uploads
STORAGE_MAX_FILE_SIZE_BYTES=15728640

# --- Bootstrap admin (A3c, dev/test only) ---
# When set on a non-production NODE_ENV, `pnpm db:seed` upserts this user as
# ADMIN with a pre-verified phone (skips OTP). Production seed runs ignore
# this and warn — promote real admins with `pnpm api:promote-admin <phone>`.
BOOTSTRAP_ADMIN_PHONE=+905551234567

# --- Pricing / Distance (A4a) ---
# Google Maps Distance Matrix API key. The default `AIzaSy_DUMMY_*` value
# switches PricingModule to MockDistanceCalculator (haversine) so local dev
# and CI run without a real key. Replace with a real key for prod. ADR 0018.
GOOGLE_MAPS_API_KEY=AIzaSy_DUMMY_REPLACE_WITH_REAL_KEY
GOOGLE_MAPS_RATE_LIMIT_PER_SECOND=10
# How long a PriceQuote stays ACTIVE before EXPIRED. ADR 0017.
PRICE_QUOTE_TTL_SECONDS=900

# --- Dispatch / Driver matching (A4c) — ADR 0020 ---
DISPATCH_MAX_RADIUS_KM=25
DISPATCH_MIN_RATING=4.0
DISPATCH_DISTANCE_WEIGHT=0.7
DISPATCH_RATING_WEIGHT=0.3
DISPATCH_MAX_ATTEMPTS=3
DISPATCH_RETRY_COOLDOWN_MS=60000
DISPATCH_WORKER_INTERVAL_MS=30000
DISPATCH_LOCATION_FRESHNESS_SECONDS=300

# --- Sentry (optional in dev; required in production) ---
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
